<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SecureVault"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#58A6FF"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AES-256 шифрование файлов"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:layout_marginBottom="20dp"/>

        <!-- Статус -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161B22"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СТАТУС"
                android:textSize="11sp"
                android:textColor="#8B949E"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Загрузка..."
                android:textSize="13sp"
                android:textColor="#E6EDF3"
                android:lineSpacingExtra="4dp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Device Admin -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE ADMIN"
            android:textSize="11sp"
            android:textColor="#8B949E"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnActivateAdmin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Активировать Admin"
            android:textColor="#FFFFFF"
            android:backgroundTint="#238636"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnLock"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Заблокировать экран"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6FEB"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDeactivate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Деактивировать Admin"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6E7681"
            android:layout_marginBottom="20dp"/>

        <!-- Шифрование -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ШИФРОВАНИЕ AES-256"
            android:textSize="11sp"
            android:textColor="#8B949E"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSetEncPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Установить пароль шифрования"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6E40C9"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Сфотографировать и зашифровать"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6FEB"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnPickFile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Выбрать файл и зашифровать"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1F6FEB"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnDecrypt"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Расшифровать файл"
            android:textColor="#FFFFFF"
            android:backgroundTint="#9E6A03"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
